# LeadFlow — copy to .env.local and fill in your own values.
# Never commit .env.local. Never put the Supabase service_role key here
# (or anywhere in the frontend) — the app only ever uses it server-side
# (email queue worker + unsubscribe route); see below.

# Public Supabase project values (Project Settings > API).
# These are public by design; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Secret used to encrypt users' provider API keys (AES-256-GCM).
# Must be a base64-encoded 32-byte key. Generate one in a browser console:
#   btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32))))
# Local dev: put it in .env.local. Production: set it as a Secret in
# Cloudflare (Workers & Pages > leadflow > Settings > Variables and Secrets).
# If you lose it, every user must re-enter their provider keys.
ENCRYPTION_KEY=YOUR-BASE64-32-BYTE-KEY

# Email queue (Phase 5) — server-only secrets, never in the browser.
# SUPABASE_SERVICE_ROLE_KEY: from Supabase > Project Settings > API.
# Used ONLY by the queue worker (cron mode) and the unsubscribe route.
# CRON_SECRET: any long random string. The queue endpoint only accepts
# requests carrying `Authorization: Bearer <CRON_SECRET>`.
# Both must be Cloudflare Secrets in production. Without them, "Send now"
# (per-user processing) still works, but no automatic background sending.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
CRON_SECRET=YOUR-LONG-RANDOM-CRON-SECRET

# Resend webhooks (Phase 6) — server-only secret, never in the browser.
# From Resend > Settings > Webhooks: the signing secret for the endpoints
# /api/email/webhooks/resend (deliveries, bounces, complaints) and
# /api/email/webhooks/resend-inbound (replies). Without it, webhook routes
# fail closed (401) and no bounce/reply events are recorded.
RESEND_WEBHOOK_SECRET=whsec_YOUR-WEBHOOK-SECRET
